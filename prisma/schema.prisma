// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  fullName  String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  orders    Order[]
  role String @default("customer")
  businessName String?
  products  Product[] @relation("VendorProducts")
  passwordResetTokens PasswordResetToken[]
  reviews   Review[]
  wishlistItems WishlistItem[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid()) // Default to cuid, but can be set manually for seeding
  name        String
  description String?
  image       String?
  vendor      String                            // Display name (kept for old seeded rows without a real account)
  vendorId    String?                           // Real link to the vendor's User account (used for new products)
  vendorUser  User?       @relation("VendorProducts", fields: [vendorId], references: [id])
  price       Int         // Store in cents/smallest unit to avoid floating point issues
  category    String
  stock       Int         @default(999)
  rating      Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
  wishlistItems WishlistItem[]

  @@index([vendorId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      // 1-5
  comment   String?
  verifiedPurchase Boolean @default(false) // true if the reviewer has a PAID order containing this product
  createdAt DateTime @default(now())

  @@unique([productId, userId]) // one review per customer per product
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  itemsSubtotal Int       @default(0) // Sum of product prices x quantity, before delivery
  deliveryFee   Int       @default(0) // Flat delivery fee applied at checkout time
  totalAmount Int         // itemsSubtotal + deliveryFee — this is what's actually charged
  // Order lifecycle: PENDING_PAYMENT -> PROCESSING -> SHIPPED -> DELIVERED (or CANCELLED at any point before SHIPPED)
  status      String      @default("PENDING_PAYMENT")
  // Payment lifecycle: UNPAID -> PAID / FAILED
  paymentStatus    String  @default("UNPAID")
  paymentMethod    String?  // "MOMO", "ORANGE_MONEY", "CARD"
  paymentProvider  String?  // "cinetpay"
  paymentReference String?  @unique // transaction id returned by the payment provider
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
  shippingAddress String @default("")
  shippingCity String @default("")
  shippingPhone String @default("")

  @@index([paymentReference])
}

model OrderItem {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  productId String
  product   Product   @relation(fields: [productId], references: [id]) // Link to Product model
  quantity  Int
  price     Int       // Price at the time of order
  // Commission snapshot — locked in at order time so a later rate change never
  // retroactively rewrites past earnings. platformFee + vendorEarning == price * quantity.
  commissionRate Float @default(0)  // e.g. 0.10 for 10%, as it was at the time of this order
  platformFee    Int   @default(0)  // GlobalMart's cut, in the same currency unit as price
  vendorEarning  Int   @default(0)  // What the vendor actually earns from this line
  createdAt DateTime  @default(now())
}